# --- Service (gateway này) ---
# Driver: "mock" (offline, không cần mạng/key) | "meta" (gọi official API)
MUSE2API_DRIVER=mock
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
# Bearer token bảo vệ gateway. Bỏ trống -> tự sinh lần đầu và lưu vào data/api_key
MUSE2API_KEY=
MUSE2API_DATA_DIR=./data
MUSE2API_LOG_LEVEL=INFO

# --- Upstream: Meta Model API ---
# Cách 1 (khuyên dùng nếu không muốn mua key): chạy `python -m muse2api login`
# để đúc key qua OAuth device flow của Meta. Key lưu ở data/meta_key.json,
# tự đúc lại mỗi ngày.
#
# Cách 2: dán key tĩnh của bạn (lấy từ nền tảng developer của Meta)
META_API_KEY=
# MODEL_API_KEY=   # tên thay thế, cũng được chấp nhận

# --- Timeout (giây) ---
MUSE2API_TIMEOUT=60
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_IMAGE_TIMEOUT=240
